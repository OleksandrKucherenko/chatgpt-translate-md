{
  "name": "gpt",
  "private": true,
  "license": "private",
  "packageManager": "yarn@4.15.0",
  "workspaces": [
    "packages/*",
    "clis/*",
    "services/*",
    "websites/*"
  ],
  "scripts": {
    "cli": "yarn workspace cli-gpt dev",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore .",
    "format:fix": "oxfmt --write --ignore-path .oxfmtignore .",
    "gitleaks:detect": "mkdir -p reports && gitleaks detect --no-banner -l debug --verbose --report-path reports/gitleaks.json --report-format json",
    "gitleaks:protect": "mkdir -p reports && gitleaks protect --staged --no-banner --report-path reports/gitleaks.json --report-format json",
    "build": "yarn workspaces foreach --recursive --topological-dev --verbose run build",
    "cleanup": "yarn workspaces foreach --parallel --recursive --verbose run cleanup",
    "test": "vitest run --coverage",
    "test:ui": "vitest --ui --watch --coverage --api.port 51204 --api.host 0.0.0.0 --api.allowWrite=false --api.allowExec=false --open=false",
    "typecheck:native": "tsgo --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@goldstack/utils-typescript-references": "^0.3.30",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.9.1",
    "@types/uuid": "^11.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260526.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "husky": "^9.1.7",
    "json5": "^2.2.3",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "volta": {
    "node": "24.16.0",
    "yarn": "4.15.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write --ignore-path .oxfmtignore"
    ],
    "*.{json,jsonc,md,yml,yaml}": "oxfmt --write --ignore-path .oxfmtignore"
  },
  "dependencies": {
    "cli-gpt": "workspace:^"
  }
}
